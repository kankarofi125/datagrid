# =============================================================================
# DataGrid environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Neon Postgres ---
# Pooled (app runtime) — host includes -pooler
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (migrations / prisma db push) — host WITHOUT -pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- App ---
SESSION_SECRET="replace-with-32+-char-secret"
PAYMENT_MODE="simulate"
# Providers (fixed split):
#   email  → Brevo only (OTP/2FA, fund, purchase)
#   sms/wa → Sendchamp only
# sendchamp = real OTP (required in production). simulate = local console only (blocked in prod).
OTP_MODE="sendchamp"
# Only used when OTP_MODE=simulate on local machines.
OTP_DEV_CODE="1234"
# Channels: whatsapp | sms | email | whatsapp,email | both
# Login email-2FA always uses channels=email → Brevo.
OTP_CHANNELS="whatsapp"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="2348000000000"
NEXT_PUBLIC_APP_NAME="DataGrid"
NEXT_PUBLIC_ENABLE_SW=
# Public, monitored address shown on Privacy and Terms pages.
NEXT_PUBLIC_LEGAL_EMAIL="privacy@datagrid.ng"
# Optional ownership-verification tokens for search consoles.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Google login (OAuth 2.0 Web application) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud.
# Optional. Defaults to the *request host* + /api/auth/google/callback so
# localhost and production stay consistent with PKCE cookies.
# In Google Cloud Console → Credentials → Authorized redirect URIs, add BOTH:
#   https://your-domain.com/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Vercel Cron (Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET="replace-with-long-random-cron-secret"

# --- Upstash Redis (cache + SSE/WS fan-out) ---
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# --- Realtime WebSocket gateway (Fly.io / Railway) ---
# Leave empty until the service is deployed; app falls back to SSE.
# NEXT_PUBLIC_REALTIME_WS_URL="wss://datagrid-realtime-ws.fly.dev"
# REALTIME_WS_INTERNAL_URL="https://datagrid-realtime-ws.fly.dev"
NEXT_PUBLIC_REALTIME_WS_URL=
REALTIME_WS_INTERNAL_URL=
REALTIME_WS_SECRET="replace-with-shared-ws-secret"

# --- Payments ---
# simulate = test wallet credits for logged-in users (no live Paystack/Monnify).
# live     = real gateways (set keys below). Use live only when payments are active.
PAYMENT_MODE="simulate"
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
FLUTTERWAVE_SECRET_KEY=

# --- Messaging (Sendchamp) — SMS + WhatsApp OTP only ---
# Email is NOT sent via Sendchamp (see Brevo section below).
# https://sendchamp.readme.io/reference/introduction
# Dashboard → Account Settings → API Key / Webhook → Access key
# Quote if the key contains $ characters
SENDCHAMP_API_KEY=
SENDCHAMP_BASE_URL="https://api.sendchamp.com/api/v1"
# SMS Sender ID shown on the phone. Use "Sendchamp" until a custom brand
# (e.g. DataGrid) is approved in the Sendchamp dashboard (often ≤11 chars).
SENDCHAMP_SMS_SENDER="Sendchamp"
# dnd | non_dnd | international
SENDCHAMP_SMS_ROUTE="dnd"
# Optional WhatsApp *sender* on Sendchamp (business line on THEIR platform).
# Not the end-user phone. Not your support FAB number. Empty = account default.
SENDCHAMP_WHATSAPP_SENDER=
# Fallback to SMS if WhatsApp fails (1/0)
OTP_WHATSAPP_FALLBACK_SMS="1"
# Unused by app (email is Brevo-only). Safe to leave empty.
SENDCHAMP_EMAIL_FROM=
SENDCHAMP_EMAIL_FROM_NAME="DataGrid"

# --- Email (Brevo) — ALL product email (OTP/2FA, fund, purchase) ---
# Required on Vercel Production for email 2FA and receipts.
# API key: app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=
# Verified sender (Senders, domains & dedicated IPs)
BREVO_FROM_EMAIL="auth@datagrid-ng.com"
BREVO_FROM_NAME="DataGrid"
# auto | api | smtp — prefer smtp on Vercel if Authorised IPs block the API
BREVO_TRANSPORT="auto"
# Authorised IPs: https://app.brevo.com/security/authorised_ips
# For Vercel: disable IP restriction OR set BREVO_TRANSPORT=smtp.
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# Local only: if set to 1 and NODE_ENV!=production, log OTP when Brevo fails.
# Ignored/blocked in production — real Brevo delivery is required.
# OTP_EMAIL_DEV_FALLBACK=

# Optional dashboard webhook (delivery reports):
# https://your-domain.com/api/webhooks/sendchamp

# Legacy (unused when SENDCHAMP_API_KEY is set)
TERMII_API_KEY=

# --- VTU providers (empty = simulator) ---
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
