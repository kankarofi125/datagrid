# =============================================================================
# DataGrid environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Neon Postgres ---
# Pooled (app runtime) — host includes -pooler
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (migrations / prisma db push) — host WITHOUT -pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# --- App ---
SESSION_SECRET="replace-with-32+-char-secret"
PAYMENT_MODE="simulate"
# simulate = console OTP (dev). sendchamp = live SMS/email via Sendchamp.
OTP_MODE="simulate"
OTP_DEV_CODE="1234"
# sms | email | both — delivery channels when OTP_MODE=sendchamp
OTP_CHANNELS="sms"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP="2348000000000"
NEXT_PUBLIC_APP_NAME="DataGrid"
NEXT_PUBLIC_ENABLE_SW=
# Public, monitored address shown on Privacy and Terms pages.
NEXT_PUBLIC_LEGAL_EMAIL="privacy@datagrid.ng"
# Optional ownership-verification tokens for search consoles.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Google login (OAuth 2.0 Web application) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in Google Cloud.
# Defaults to NEXT_PUBLIC_APP_URL + /api/auth/google/callback when empty.
GOOGLE_REDIRECT_URI=

# --- Vercel Cron (Authorization: Bearer <CRON_SECRET>) ---
CRON_SECRET="replace-with-long-random-cron-secret"

# --- Upstash Redis (cache + SSE/WS fan-out) ---
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# --- Realtime WebSocket gateway (Fly.io / Railway) ---
# Leave empty until the service is deployed; app falls back to SSE.
# NEXT_PUBLIC_REALTIME_WS_URL="wss://datagrid-realtime-ws.fly.dev"
# REALTIME_WS_INTERNAL_URL="https://datagrid-realtime-ws.fly.dev"
NEXT_PUBLIC_REALTIME_WS_URL=
REALTIME_WS_INTERNAL_URL=
REALTIME_WS_SECRET="replace-with-shared-ws-secret"

# --- Payments (empty = simulate) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
FLUTTERWAVE_SECRET_KEY=

# --- Messaging (Sendchamp) ---
# https://sendchamp.readme.io/reference/introduction
# Dashboard → Account Settings → API Key / Webhook → Access key
# Quote if the key contains $ characters
SENDCHAMP_API_KEY=
SENDCHAMP_BASE_URL="https://api.sendchamp.com/api/v1"
# SMS Sender ID (register on Sendchamp dashboard) or "Sendchamp" for tests
SENDCHAMP_SMS_SENDER="Sendchamp"
# dnd | non_dnd | international
SENDCHAMP_SMS_ROUTE="dnd"
# Email OTP uses branded HTML (logo + DataGrid theme) via /email/send.
# From-address must be verified/allowed on Sendchamp (or use their default).
SENDCHAMP_EMAIL_FROM=
SENDCHAMP_EMAIL_FROM_NAME="DataGrid"
# Enable email OTP: OTP_CHANNELS=email or both (user must have email on file)
# Optional dashboard webhook (delivery reports):
# https://your-domain.com/api/webhooks/sendchamp

# Legacy (unused when SENDCHAMP_API_KEY is set)
TERMII_API_KEY=

# --- VTU providers (empty = simulator) ---
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
CLUBKONNECT_USER_ID=
CLUBKONNECT_API_KEY=
